# ===========================================
# RAG Chatbot Configuration
# ===========================================
# Copy this file to .env and override values as needed.
# Only lists values the backend actually reads (see backend/config/settings.py).

# --- Application ---
APP_NAME=RAG Chatbot
APP_ENVIRONMENT=development
DEBUG=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# --- LLM (Ollama) ---
# Ollama runs as a service on the host. Pull model first: `ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.95
LLM_PRESENCE_PENALTY=0.2
LLM_FREQUENCY_PENALTY=0.3

# --- RAGAS (evaluation only) ---
# Judge model for RAGAS metrics. Leave empty to reuse OLLAMA_MODEL.
# Use a ≥7B model — smaller ones fail JSON parsing.
RAGAS_JUDGE_MODEL=
RAGAS_TIMEOUT_SECONDS=600
RAGAS_MAX_RETRIES=3

# --- Resilience ---
REQUEST_TIMEOUT=300
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=2
RETRY_INITIAL_DELAY=1.0
RETRY_MAX_DELAY=10.0
MAX_CONCURRENT_REQUESTS=50

# --- Embeddings (CPU by default) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu

# --- Vector Database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
COLLECTION_NAME=documents

# --- Document Processing ---
MAX_FILE_SIZE_MB=50
SUPPORTED_EXTENSIONS=[".pdf",".docx",".txt",".md"]

# Section-Aware Chunker
SECTION_MAX_CHUNK_TOKENS=600
SECTION_MIN_CHUNK_TOKENS=80
SECTION_OVERLAP_SENTENCES=2
SECTION_SEMANTIC_LOOK_BACK=3
SECTION_SEMANTIC_MIN_SCORE=0.15

# --- Retrieval ---
TOP_K_RETRIEVAL=40
TOP_K_RERANK=7               # simple/single-intent queries
TOP_K_RERANK_COMPLEX=20      # complex decomposed queries (more chunks to cover all sub-questions)
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_SCORE_THRESHOLD=0.35
RERANKER_SCORE_THRESHOLD_COMPLEX=0.20  # lower gate for decomposed queries
USE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.7             # default: 70% dense, 30% keyword
HYBRID_ALPHA_LEGAL=0.55      # legal/compliance queries: more keyword weight
HYBRID_RRF_MIN_RATIO=0.2
RETRIEVAL_SCORE_THRESHOLD=0.3

# --- Query Rewriting (multi-turn) ---
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MIN_TURNS=2

# --- Multi-Query & Decomposition ---
# MULTI_QUERY_ENABLED=true activates the expander for all queries.
# Simple queries → paraphrase mode (MULTI_QUERY_COUNT variants).
# Complex multi-part queries → decompose mode (atomic sub-questions).
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=2
DECOMPOSE_ENABLED=true
DECOMPOSE_MIN_WORDS=8

# --- Cache (Redis, optional) ---
USE_CACHE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600

# --- Storage ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# --- HuggingFace Model Cache ---
HF_HOME=./models
SENTENCE_TRANSFORMERS_HOME=./models
TRANSFORMERS_CACHE=./models

# --- Logging ---
LOG_LEVEL=INFO
# "json" for production, "console" for local dev
LOG_FORMAT=console

# --- Security / CORS ---
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
