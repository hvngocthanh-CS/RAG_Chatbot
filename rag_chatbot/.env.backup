# ===========================================

# RAG Enterprise Chatbot Configuration (Optimized for RTX 3060 6GB)

# ===========================================

# ===========================================

# Application Settings

# ===========================================

APP_NAME="RAG Enterprise Chatbot"
APP_VERSION=1.0.0
APP_ENVIRONMENT=production
DEBUG=False

# ===========================================

# API Settings

# ===========================================

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_WORKERS=4

# Rate Limiting

RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Request Settings

REQUEST_TIMEOUT=120
MAX_CONCURRENT_REQUESTS=10

# ===========================================

# LLM Settings - Ollama (Windows Native, GPU Optimized)

# ===========================================

# SWITCH PROVIDER: Change to 'ollama' for Windows (no Docker)
# Options: 'vllm' (Docker only) | 'ollama' (Windows native)
LLM_PROVIDER=ollama

# Ollama Configuration (Windows Native)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=phi3
OLLAMA_API_KEY=not-needed

# vLLM Server Configuration (Docker only - for reference)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL_NAME=microsoft/Phi-3-mini-4k-instruct
VLLM_API_KEY=not-needed

# vLLM GPU Optimization (TUNED FOR 6GB VRAM)

VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.8
VLLM_MAX_MODEL_LEN=1024
VLLM_QUANTIZATION=
VLLM_DTYPE=float16
VLLM_TRUST_REMOTE_CODE=True

# Generation Settings

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_REPETITION_PENALTY=1.1
LLM_PRESENCE_PENALTY=0.0
LLM_FREQUENCY_PENALTY=0.0

# ===========================================

# Resilience Settings

# ===========================================

CIRCUIT_BREAKER_ENABLED=True
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

RETRY_ENABLED=True
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=1.0
RETRY_MAX_DELAY=10.0
RETRY_EXPONENTIAL_BASE=2.0

# ===========================================

# Embedding Settings (CPU OPTIMIZED - Production Quality)

# ===========================================

EMBEDDING_PROVIDER=huggingface
# Model production chất lượng cao
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_DEVICE=cpu

# ===========================================

# Vector Database

# ===========================================

VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=documents

# ===========================================

# Document Processing

# ===========================================

CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_FILE_SIZE_MB=50
SUPPORTED_EXTENSIONS=[".pdf",".docx",".txt",".md"]

# ===========================================

# Retrieval Settings (LOW LATENCY)

# ===========================================

TOP_K_RETRIEVAL=8
TOP_K_RERANK=3
USE_RERANKER=True
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
USE_HYBRID_SEARCH=True
HYBRID_ALPHA=0.5
RETRIEVAL_SCORE_THRESHOLD=0.30

# ===========================================

# Cache (DISABLED FOR LOCAL DEV)

# ===========================================

USE_CACHE=False

# ===========================================

# Storage

# ===========================================

UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# ===========================================

# Observability

# ===========================================

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_FORMAT=json
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

METRICS_ENABLED=True
METRICS_PORT=9090
METRICS_PATH=/metrics

TRACING_ENABLED=False
SERVICE_NAME=rag-chatbot

# ===========================================

# Health Check

# ===========================================

HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# ===========================================

# Security Settings

# ===========================================

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=True
API_KEY_HEADER=X-API-Key
API_KEYS=[]

# ===========================================

# Query Rewriting

# ===========================================

QUERY_REWRITE_ENABLED=True
QUERY_REWRITE_MIN_TURNS=2

# ===========================================

# Performance Tuning

# ===========================================

PRELOAD_MODELS=False
MODEL_PRELOAD_TIMEOUT=300
