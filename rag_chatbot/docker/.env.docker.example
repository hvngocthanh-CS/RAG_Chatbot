# ==================================================================
# Docker stack environment — copy to project root as .env
# ==================================================================
# cp docker/.env.docker.example .env
#
# Override these for container networking (service-name hostnames).
# ==================================================================

# --- App ---
APP_ENVIRONMENT=production
DEBUG=false

# --- LLM (Ollama on host by default) ---
# If you use --profile ollama (Ollama in container), change to:
#   OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.0

# --- Vector DB ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=documents

# --- Cache ---
USE_CACHE=true
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=3600

# --- Embeddings (baked into image) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu

# --- Retrieval ---
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
USE_HYBRID_SEARCH=true
TOP_K_RETRIEVAL=40
TOP_K_RERANK=5

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- CORS — set to your frontend domain in production ---
CORS_ORIGINS=["*"]
